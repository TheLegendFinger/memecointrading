# Copy to .env. Never commit the real file - .env is gitignored.

# ---------------------------------------------------------------------------
# Live trading (ignored in paper mode)
# ---------------------------------------------------------------------------
# Safety interlock. Without this exact value the live executor refuses to
# place a single order, no matter what the config says.
# LIVE_TRADING_CONFIRM=I_UNDERSTAND_THE_RISK

# The wallet that will sign swaps. Use a burner funded with only what you are
# willing to lose - this key can move every token in the account.
# Either a base58 secret key...
# SOLANA_PRIVATE_KEY=
# ...or a Solana CLI keypair file (a JSON array of bytes).
# SOLANA_KEYPAIR_PATH=~/.config/solana/id.json

# A private RPC (Helius, QuickNode, Triton...) is strongly recommended; the
# public endpoint is rate limited and will drop your transactions.
# MEMEBOT_RPC_URL=https://mainnet.helius-rpc.com/?api-key=...

# ---------------------------------------------------------------------------
# Optional overrides (these beat the config file)
# ---------------------------------------------------------------------------
# MEMEBOT_MODE=paper
# MEMEBOT_STARTING_CASH=1000
# MEMEBOT_MAX_POSITIONS=5
# MEMEBOT_POSITION_SIZE_PCT=0.08
# MEMEBOT_SLIPPAGE_BPS=150
# MEMEBOT_POLL_INTERVAL=30
# MEMEBOT_LOG_LEVEL=INFO
