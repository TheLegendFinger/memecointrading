# Copy to .env. Never commit the real file - .env is gitignored.

# ---------------------------------------------------------------------------
# State storage
# ---------------------------------------------------------------------------
# Leave unset to keep state in data/memebot.sqlite3 on this machine.
# Set it to share one book between a local bot and a hosted dashboard - the
# same value goes in the Vercel project's environment variables.
# DATABASE_URL=postgresql://user:password@host/dbname

# Needed to call the deployment's /api/cycle endpoint. Any long random string;
# without it that endpoint refuses every request.
# CRON_SECRET=

# ---------------------------------------------------------------------------
# Live trading (ignored in paper mode)
# ---------------------------------------------------------------------------
# Safety interlock. Without this exact value the live executor refuses to place
# a single order, no matter what the config says.
#
# Prefer NOT to set it here. scripts\live.ps1 sets it for its own window only,
# so nothing else you run can trade real money by accident. Uncomment it only
# if you are scripting live trading yourself.
# LIVE_TRADING_CONFIRM=I_UNDERSTAND_THE_RISK

# The wallet that will sign swaps. Use a burner funded with only what you are
# willing to lose - this key can move every token in the account.
# Create one with:  scripts\wallet.ps1 -New -Save
# Either a base58 secret key...
# SOLANA_PRIVATE_KEY=
# ...or a Solana CLI keypair file (a JSON array of bytes).
# SOLANA_KEYPAIR_PATH=~/.config/solana/id.json

# A private RPC (Helius, QuickNode, Triton...) is strongly recommended; the
# public endpoint is rate limited and will drop your transactions.
# MEMEBOT_RPC_URL=https://mainnet.helius-rpc.com/?api-key=...

# ---------------------------------------------------------------------------
# Optional overrides (these beat the config file)
# ---------------------------------------------------------------------------
# MEMEBOT_MODE=paper
# MEMEBOT_STARTING_CASH=1000
# MEMEBOT_MAX_POSITIONS=5
# MEMEBOT_POSITION_SIZE_PCT=0.08
# MEMEBOT_SLIPPAGE_BPS=150
# MEMEBOT_POLL_INTERVAL=30
# MEMEBOT_LOG_LEVEL=INFO

# A paid Jupiter key raises the API rate limit (the keyless tier is fine for a
# handful of orders per minute).
# JUPITER_API_KEY=
