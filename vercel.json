{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/scan.py": {
      "maxDuration": 60
    },
    "api/health.py": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
